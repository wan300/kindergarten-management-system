# Optional Docker Compose overrides for local development.
# Copy to .env if you need to customize host ports or frontend origin.

BACKEND_HOST_PORT=3001
FRONTEND_HOST_PORT=4000
FRONTEND_ORIGIN=http://localhost:4000

# Vue/Vite frontend overrides. Leave VITE_API_BASE_URL empty to use the
# relative Rails API in production and the Vite proxy during development.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:3000
# Production uses the same-origin Nginx proxy. Set http://localhost:8080
# explicitly only when running the Child Growth OS locally.
VITE_CHILD_DEV2_URL=/child-growth/

# Optional AI integration.
DEEPSEEK_API_KEY=

# Optional QQ SMTP integration for parenting advice email schedules.
QQ_SMTP_USER=
QQ_SMTP_PASSWORD=
QQ_SMTP_ADDRESS=smtp.qq.com
QQ_SMTP_PORT=587
QQ_SMTP_FROM=
