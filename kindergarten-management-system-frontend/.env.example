# Optional absolute Rails API origin. Leave empty for relative API paths.
VITE_API_BASE_URL=

# Used only by the Vite development proxy.
VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# Independent Child Growth OS URL embedded in the admin dashboard.
# The production Nginx proxy serves this path on the same public origin.
VITE_CHILD_DEV2_URL=/child-growth/
