# Dependencies
**/node_modules/
**/.pnp
**/.pnp.js

# Build and coverage output
kindergarten-management-system-frontend/build/
**/coverage/

# Rails runtime artifacts
kindergarten-management-system-backend/log/*
!kindergarten-management-system-backend/log/.keep
kindergarten-management-system-backend/tmp/*
!kindergarten-management-system-backend/tmp/.keep
!kindergarten-management-system-backend/tmp/pids/
!kindergarten-management-system-backend/tmp/pids/.keep
kindergarten-management-system-backend/tmp/pids/*.pid
kindergarten-management-system-backend/tmp/storage/**
kindergarten-management-system-backend/storage/*
!kindergarten-management-system-backend/storage/.keep

# Local databases
kindergarten-management-system-backend/db/*.sqlite3
kindergarten-management-system-backend/db/*.sqlite3-*

# Local bundle/cache
kindergarten-management-system-backend/vendor/bundle/
kindergarten-management-system-backend/.bundle/

# Secrets and local environment
.env
.env.*
!.env.example
kindergarten-management-system-backend/config/master.key

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS/editor noise
.DS_Store
Thumbs.db
.playwright-mcp/
.codex-runtime-logs/
deploy-current-*.tar.gz

# Local credential/reference exports
kindergarten-demo-accounts.md

# child_dev2 imported source: keep runtime/local metadata out of the parent repo
child_dev2/.git-backup-*/
child_dev2/.venv/
child_dev2/backend/.venv/
child_dev2/data/
child_dev2/logs/
child_dev2/tmp/
child_dev2/upstream_repos/
child_dev2/frontend/dist/
child_dev2/frontend/.vite/
child_dev2/*.db
child_dev2/*.sqlite
child_dev2/*.sqlite3

# Local visual design sessions
.superpowers/

# Isolated local feature workspaces
.worktrees/
